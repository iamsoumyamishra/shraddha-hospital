{
  "name": "@hospital/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/generated/prisma/client.ts",
    "./url": "./src/url.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "build": "node --env-file-if-exists=../../apps/web/.env ./node_modules/prisma/build/index.js generate --config ../../apps/web/prisma.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5",
    "@types/node": "^20",
    "@hospital/typescript-config": "workspace:*"
  }
}
