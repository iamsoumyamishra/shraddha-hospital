{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "apps/*/.env*"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "STORAGE_DATABASE_URL*",
    "BETTER_AUTH_*",
    "NEXT_PUBLIC_*",
    "HOSPITAL_*",
    "PUBLIC_*",
    "PRIVACY_NOTICE_VERSION",
    "SMALL_SAMPLE_THRESHOLD",
    "GEMINI_*",
    "RATE_LIMIT_*",
    "AUTH_RATE_LIMIT_*",
    "TEST_DATABASE_URL",
    "SEED_STAFF_*",
    "E2E_*",
    "SURVEY_MANAGEMENT_E2E",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ],
      "cache": false
    },
    "test:unit": {
      "dependsOn": [
        "^build",
        "^test:unit"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
