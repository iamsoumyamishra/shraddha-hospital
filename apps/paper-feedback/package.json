{
  "name": "@hospital/paper-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "pnpm --filter @hospital/web db:deploy && pnpm --filter @hospital/database build && next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "better-auth": "^1.7.7",
    "zod": "^4.6.5",
    "server-only": "^0.0.1",
    "lucide-react": "^0.544.0",
    "@hospital/database": "workspace:*",
    "@hospital/identity": "workspace:*",
    "@hospital/scoring": "workspace:*",
    "tesseract.js": "^7.0.0",
    "jspdf": "^4.2.1",
    "@hospital/forms": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "vitest": "^5.0.3",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.15",
    "dotenv": "^18.0.5",
    "@hospital/typescript-config": "workspace:*"
  }
}
