{
  "name": "hospital-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @hospital/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @hospital/web test:e2e",
    "db:generate": "pnpm --filter @hospital/web db:generate",
    "db:migrate": "pnpm --filter @hospital/web db:migrate",
    "db:deploy": "pnpm --filter @hospital/web db:deploy",
    "db:seed": "pnpm --filter @hospital/web db:seed",
    "db:reset": "pnpm --filter @hospital/web db:reset",
    "db:studio": "pnpm --filter @hospital/web db:studio",
    "i18n:check": "pnpm --filter @hospital/web i18n:check",
    "i18n:sync": "pnpm --filter @hospital/web i18n:sync",
    "i18n:review": "pnpm --filter @hospital/web i18n:review",
    "i18n:survey": "pnpm --filter @hospital/web i18n:survey"
  },
  "devDependencies": {
    "turbo": "^2.8.19"
  }
}
