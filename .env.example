# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the app at runtime.
DATABASE_URL="postgresql://shraddha:shraddha@localhost:55432/shraddha?schema=public"

# Separate database for integration tests. Never point this at the dev database.
TEST_DATABASE_URL="postgresql://shraddha:shraddha@localhost:55432/shraddha_test?schema=public"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public origin of the application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feedback access mode. Only "qr" is implemented; any other value fails at boot.
PUBLIC_FEEDBACK_MODE="qr"

# IANA timezone used to interpret reporting date ranges. Storage stays in UTC.
HOSPITAL_TIMEZONE="Asia/Kolkata"

# Version of the privacy notice shown to patients before submitting.
PRIVACY_NOTICE_VERSION="2026-01"

# In-process rate limit for the public submit endpoint. Per instance only.
RATE_LIMIT_SUBMIT_MAX="10"
RATE_LIMIT_SUBMIT_WINDOW_MS="60000"

# Sign-in throttle. The default suits staff sharing an office IP; raise it for
# automated end-to-end runs, which sign in repeatedly from one address.
AUTH_RATE_LIMIT_MAX=3
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Minimum response count before a branch/category figure is displayed.
# Below this, the dashboard suppresses the number rather than implying precision.
SMALL_SAMPLE_THRESHOLD="5"